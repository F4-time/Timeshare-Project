# Server
PORT=3000
NODE_ENV=development

# Browser origin allowed to call this API (the Vite dev server)
ALLOWED_ORIGIN=http://localhost:5173

# Supabase — same project as the frontend.
# ANON_KEY is used for user-scoped queries so RLS still applies.
# SERVICE_ROLE_KEY bypasses RLS. Never expose it to the browser or commit it.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay — secret must stay server-side only
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
