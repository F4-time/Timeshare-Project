# Server
PORT=3000
NODE_ENV=development

# Browser origins allowed to call this API. Comma-separated — in production add
# the Vercel production domain and any preview domains.
ALLOWED_ORIGIN=http://localhost:5173

# Production only: the domain Caddy issues a TLS certificate for.
# Must already resolve to this server's public IP.
API_DOMAIN=

# Supabase — same project as the frontend.
# ANON_KEY is used for user-scoped queries so RLS still applies.
# SERVICE_ROLE_KEY bypasses RLS. Never expose it to the browser or commit it.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay — secret must stay server-side only
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
